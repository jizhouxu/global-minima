---
import "../styles/global.css";
import ThemeSuns from "../components/ThemeSuns.astro";
import "katex/dist/katex.min.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  pubDate?: Date;
  /** 'article' for posts, 'website' for other pages */
  ogType?: "article" | "website";
  /** Show the CSS scroll-driven reading progress bar (posts only) */
  showProgress?: boolean;
}

const {
  title,
  description = "Personal essays and technical writing.",
  ogImage,
  pubDate,
  ogType = "website",
  showProgress = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = "Global Minima";

// Active nav detection
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname;
const isAbout  = pathname === `${base}/about` || pathname === `${base}/about/`;
const isWriting = pathname === `${base}/writing` || pathname.startsWith(`${base}/writing/`) || pathname.startsWith(`${base}/tags/`);
// Local images are public/ assets under the site base; absolute URLs stay intact.
const resolvedOgImage = ogImage
  ? new URL(ogImage.replace(/^\/(?!\/)/, ''), new URL(`${base}/`, Astro.site)).toString()
  : undefined;
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{title === siteName ? title : `${title} — ${siteName}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OpenGraph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    {
      pubDate && (
        <meta
          property="article:published_time"
          content={pubDate.toISOString()}
        />
      )
    }

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} RSS Feed`}
      href={new URL(`${base}/rss.xml`, Astro.site)}
    />

    <!-- Favicon — must include base path to match Astro's public/ asset routing -->
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <!-- Set data-theme before first paint to prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark" || t === "light")
            document.documentElement.dataset.theme = t;
        } catch {
          /* Storage may be disabled; the system theme still works. */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {showProgress && <div class="reading-progress" aria-hidden="true" />}
    <header class="site-header">
      <nav class="site-nav" aria-label="Main navigation">
        <a href={import.meta.env.BASE_URL || "/"} class="site-title"
          >{siteName}</a
        >
        <a href={`${base}/about`} aria-current={isAbout ? 'page' : undefined}>About</a>
        <a href={`${base}/writing`} aria-current={isWriting ? 'page' : undefined}>Writing</a>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Switch theme"
        >
          <ThemeSuns />
        </button>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>© {new Date().getFullYear()} {siteName}</span>
        <div style="display:flex;gap:0.5rem;align-items:center;">
          <!-- LinkedIn -->
          <a href="https://www.linkedin.com/in/jizhou-x-b6672782/" class="share-btn" target="_blank" rel="noopener noreferrer" title="Jizhou Xu on LinkedIn" aria-label="Jizhou Xu on LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <!-- X -->
          <a href="https://x.com/jizhouxu" class="share-btn" target="_blank" rel="noopener noreferrer" title="Jizhou Xu on X" aria-label="Jizhou Xu on X">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.91-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <!-- GitHub -->
          <a href="https://github.com/jizhouxu" class="share-btn" target="_blank" rel="noopener noreferrer" title="Jizhou Xu on GitHub" aria-label="Jizhou Xu on GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
          </a>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        var html = document.documentElement;

        function current() {
          if (html.dataset.theme) return html.dataset.theme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        function sync() {
          var t = current();
          /* Name the action; CSS displays the current theme. */
          btn.setAttribute(
            "aria-label",
            t === "dark"
              ? "Switch to light theme"
              : "Switch to dark theme",
          );
        }

        sync();
        /* Keep in sync if system pref changes while page is open */
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", sync);

        btn.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          html.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch {
            /* Apply the theme even when the preference cannot be saved. */
          }
          sync();
        });
      })();
    </script>
  </body>
</html>

<!-- Flat solar marks identify the current theme; the button names the next one. -->
<svg class="icon-sun-light" viewBox="0 0 64 64" width="38" height="38" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="solar-day-halo">
      <stop offset="0.44" stop-color="var(--text)" stop-opacity="0.16" />
      <stop offset="0.7" stop-color="var(--text)" stop-opacity="0.045" />
      <stop offset="1" stop-color="var(--text)" stop-opacity="0" />
    </radialGradient>
  </defs>
  <circle cx="32" cy="32" r="31" fill="url(#solar-day-halo)" />
  <circle cx="32" cy="32" r="13" fill="var(--text)" />
  <path d="M32 8V12 M32 52V56 M8 32H12 M52 32H56 M15 15L18 18 M46 46L49 49 M15 49L18 46 M46 18L49 15" stroke="var(--text)" stroke-width="1.7" stroke-linecap="round" />
</svg>
<svg class="icon-sun-dark" viewBox="0 0 64 64" width="38" height="38" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="solar-night-halo">
      <stop offset="0.45" stop-color="var(--text)" stop-opacity="0" />
      <stop offset="0.55" stop-color="var(--text)" stop-opacity="0.28" />
      <stop offset="0.72" stop-color="var(--text)" stop-opacity="0.08" />
      <stop offset="1" stop-color="var(--text)" stop-opacity="0" />
    </radialGradient>
  </defs>
  <circle cx="32" cy="32" r="31" fill="url(#solar-night-halo)" />
  <circle cx="32" cy="32" r="17" fill="var(--bg)" stroke="var(--text)" stroke-width="1.6" />
</svg>

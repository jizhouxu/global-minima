---
import type { CollectionEntry } from 'astro:content';
import { readingTime, getSlug, formatShortDate, tagPath } from '../utils/reading-time';

interface Props {
  post: CollectionEntry<'writing'>;
  heading?: 'h3' | 'h4';
}

const { post, heading: Heading = 'h3' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<li class="essays-item">
  <div class="essays-title-row">
    <Heading class="essays-heading">
      <a class="essays-title" href={`${base}/writing/${getSlug(post.id)}`}>
        {post.data.title}
      </a>
    </Heading>
    {post.data.tags.length > 0 && (
      <div class="essays-tags">
        {post.data.tags.map((tag) => (
          <a href={`${base}${tagPath(tag)}`} class="tag">{tag}</a>
        ))}
      </div>
    )}
    <div class="essays-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatShortDate(post.data.pubDate)}</time>
      {' · '}{readingTime(post.body ?? '')} min read
    </div>
  </div>
  <p class="essays-desc">{post.data.description}</p>
</li>

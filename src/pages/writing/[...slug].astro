---
import { getCollection, render } from 'astro:content';
import WritingPost from '../../layouts/WritingPost.astro';
import { getSlug, comparePostsNewestFirst } from '../../utils/reading-time';

export async function getStaticPaths() {
  const posts = (await getCollection('writing')).sort(
    comparePostsNewestFirst
  ).reverse();

  return posts.map((post, index) => ({
    params: { slug: getSlug(post.id) },
    props: {
      post,
      prev: index > 0
        ? { slug: getSlug(posts[index - 1].id), title: posts[index - 1].data.title }
        : null,
      next: index < posts.length - 1
        ? { slug: getSlug(posts[index + 1].id), title: posts[index + 1].data.title }
        : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
// Content Layer entries (including nested folders) render at their full id path.
const { Content } = await render(post);
---

<WritingPost post={post} prev={prev} next={next}>
  <Content />
</WritingPost>

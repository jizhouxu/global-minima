---
import Layout from '../../layouts/Layout.astro';
import WritingArchive from '../../components/WritingArchive.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('writing');
---

<Layout title="Writing" description="All posts, grouped by year and month. Browse by topic.">
  <main id="main-content" class="page-container" tabindex="-1">
    <WritingArchive allPosts={posts} />
  </main>
</Layout>

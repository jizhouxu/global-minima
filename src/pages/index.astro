---
import Layout from '../layouts/Layout.astro';
import MinimaLandscape from '../components/MinimaLandscape.astro';
import EssayListItem from '../components/EssayListItem.astro';
import { getCollection } from 'astro:content';
import { comparePostsNewestFirst } from '../utils/reading-time';

const posts = (await getCollection('writing')).sort(
  comparePostsNewestFirst
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const description = 'Ideas and views on science, technology, markets, and occasionally life reflections and random topics. An outsider stepping into the frame, with more than one future in mind.';

---

<Layout title="Global Minima" description={description}>
  <main id="main-content" class="page-container" tabindex="-1">
    <header class="home-intro">
      <div>
        <h1 class="home-title">Out of Sample</h1>
        <p class="home-description">{description}</p>
      </div>
      <MinimaLandscape />
    </header>
    <section class="home-essays" aria-labelledby="recent-essays">
      <div class="page-heading-row">
        <h2 id="recent-essays" class="page-heading">Recent</h2>
        <a class="archive-link" href={`${base}/writing`}>All <span aria-hidden="true">↗</span></a>
      </div>
    {posts.length === 0 ? (
      <p style="color: var(--muted); font-family: system-ui, sans-serif; font-size: 0.9rem;">
        No posts yet. Check back soon.
      </p>
    ) : (
      <ol class="essays-list">
        {posts.map((post) => <EssayListItem post={post} />)}
      </ol>
    )}
    </section>
  </main>
</Layout>

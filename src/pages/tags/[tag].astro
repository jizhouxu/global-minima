---
import Layout from '../../layouts/Layout.astro';
import WritingArchive from '../../components/WritingArchive.astro';
import { getCollection } from 'astro:content';
import { tagSlug } from '../../utils/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('writing');

  // Collect all unique tags
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  const slugs = new Map<string, string>();
  for (const tag of tags) {
    const slug = tagSlug(tag);
    if (slugs.has(slug)) {
      throw new Error(`Tags "${slugs.get(slug)}" and "${tag}" share the URL /tags/${slug}. Use distinct tag names.`);
    }
    slugs.set(slug, tag);
  }

  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: {
      tag,
      posts,
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Layout
  title={`${tag} — Writing`}
  description={`All posts tagged "${tag}"`}
>
  <main id="main-content" class="page-container" tabindex="-1">
    <WritingArchive allPosts={posts} activeTag={tag} />
  </main>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatDate, readingTime, getSlug, tagSlug, comparePostsNewestFirst } from '../../utils/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  // Collect all unique tags
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  const slugs = new Map<string, string>();
  for (const tag of tags) {
    const slug = tagSlug(tag);
    if (slugs.has(slug)) {
      throw new Error(`Tags "${slugs.get(slug)}" and "${tag}" share the URL /tags/${slug}. Use distinct tag names.`);
    }
    slugs.set(slug, tag);
  }

  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort(comparePostsNewestFirst),
    },
  }));
}

const { tag, posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title={`#${tag}`}
  description={`All posts tagged "${tag}"`}
>
  <main id="main-content" class="page-container" tabindex="-1">
    <p style="font-family: system-ui, sans-serif; font-size: 0.85rem; color: var(--muted); margin-bottom: 0.5rem;">
      <a href={`${base}/essays`} style="color: var(--muted);">← All essays</a>
    </p>
    <h1 class="page-heading">#{tag}</h1>

    <ol class="essays-list">
      {posts.map((post) => {
        const mins = readingTime(post.body ?? '');
        return (
          <li class="essays-item">
            <h2>
              <a class="essays-title" href={`${base}/blog/${getSlug(post.id)}`}>{post.data.title}</a>
            </h2>
            <p class="essays-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              {' · '}{mins} min read
            </p>
            {post.data.description && (
              <p class="essays-desc">{post.data.description}</p>
            )}
          </li>
        );
      })}
    </ol>
  </main>
</Layout>

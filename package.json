    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.3.1",
    "katex": "^0.16.44",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "typescript": "~5.9.3"
  }
